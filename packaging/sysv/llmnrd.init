#!/bin/sh
### BEGIN INIT INFO
# Provides:          llmnrd
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Link-Local Multicast Name Resolution (LLMNR) daemon
### END INIT INFO
#
# Options: /etc/default/llmnrd (LLMNRD_OPTS)

DAEMON=/usr/sbin/llmnrd
PIDFILE=/var/run/llmnrd.pid
LLMNRD_OPTS="-6"
[ -r /etc/default/llmnrd ] && . /etc/default/llmnrd

running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "$1" in
	start)
		running && exit 0
		# wsdd2 also answers LLMNR on UDP 5355: run only one of both
		$DAEMON -d -s $LLMNRD_OPTS
		;;
	stop)
		if running; then
			kill -TERM "$(cat "$PIDFILE")"
			i=0
			while [ $i -lt 5 ] && running; do
				sleep 1
				i=$((i + 1))
			done
		fi
		rm -f "$PIDFILE"
		;;
	restart|force-reload)
		$0 stop
		$0 start
		;;
	status)
		running && echo "llmnrd is running" || { echo "llmnrd is not running"; exit 3; }
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
exit 0
