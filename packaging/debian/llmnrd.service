[Unit]
Description=Link-Local Multicast Name Resolution (LLMNR) daemon
Documentation=man:llmnrd(8)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/llmnrd
ExecStart=/usr/sbin/llmnrd -s $LLMNRD_OPTS
Restart=on-failure
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
